<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PZServerLauncher.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1220"
             d:DesignHeight="980"
             x:Class="PZServerLauncher.App.Views.SandboxWorkspaceView"
             x:Name="SandboxRoot"
             x:DataType="vm:SandboxWorkspaceViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
            <Border Classes="workspace-band" Padding="18">
                <Grid ColumnDefinitions="*,300" ColumnSpacing="18">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="kicker" Text="Sandbox" />
                        <TextBlock Classes="panel-title" FontSize="30" Text="{Binding ProfileDisplayName}" />
                        <TextBlock Classes="body"
                                   FontSize="16"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding WorkspaceSummary}"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <Border Classes="pill-dark" Margin="0,0,8,8">
                                <TextBlock Classes="pill-text-light" Text="{Binding Branch}" />
                            </Border>
                            <Border Classes="pill-soft-green" Margin="0,0,8,8">
                                <TextBlock Classes="pill-text-green" Text="{Binding ActivePresetLabel}" />
                            </Border>
                            <Border Classes="pill-soft-neutral" Margin="0,0,8,8">
                                <TextBlock Classes="pill-text-neutral" Text="{Binding CatalogSummary}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Classes="workspace-band" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="kicker" Text="Editor Status" />
                            <TextBlock Classes="body"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding LoadStatus}"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{Binding DraftStateSummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" Text="{Binding PresetSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Spacing="12">
                <Border Classes="inline-warning" Padding="16" IsVisible="{Binding RequiresAdvancedFilesFallback}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="kicker" Text="Use Advanced Files Instead" />
                        <TextBlock Classes="body" Text="{Binding FallbackReason}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SuccessSoftBrush}"
                            BorderBrush="{DynamicResource SuccessBrush}"
                            BorderThickness="0,1,0,1"
                            CornerRadius="0"
                        Padding="16"
                        IsVisible="{Binding IsShowingDraft}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="kicker" Foreground="{DynamicResource SuccessBrush}" Text="Launcher Draft Loaded" />
                        <TextBlock Classes="body" Foreground="{DynamicResource SuccessBrush}" Text="{Binding DraftStateSummary}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Foreground="{DynamicResource SuccessBrush}" Text="Save Draft keeps local changes. Apply Settings writes SandboxVars.lua." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Classes="workspace-band" Padding="16" IsVisible="{Binding CanEdit}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="kicker" Text="Detected Mod Configuration" />
                            <TextBlock Classes="caption" Text="{Binding ModSettingsSummary}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,260,260" ColumnSpacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="kicker" Text="Search" />
                                <TextBox Text="{Binding SearchText}" PlaceholderText="Search fields, values, or section names" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding HasPresets}">
                                <TextBlock Classes="kicker" Text="Preset" />
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SandboxPresetOptionViewModel">
                                            <TextBlock Text="{Binding DisplayLabel}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="6">
                                <TextBlock Classes="kicker" Text="Custom Preset Name" />
                                <TextBox Text="{Binding PresetName}" PlaceholderText="Save current settings as..." />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Orientation="Horizontal" ItemHeight="38">
                            <Button Classes="action-secondary" Margin="0,0,10,0" Command="{Binding ApplyPresetCommand}" Content="Apply Preset" />
                            <Button Classes="action-secondary" Margin="0,0,10,0" Command="{Binding ResetSelectedCategoryCommand}" Content="Reset Category" />
                            <Button Classes="action-secondary" Margin="0,0,10,0" Command="{Binding ResetAllToPresetCommand}" Content="Reset All To Preset" />
                            <Button Classes="action-primary" Margin="0,0,10,0" Command="{Binding SavePresetCommand}" Content="Save Custom Preset" />
                            <Button Classes="action-danger" Command="{Binding DeletePresetCommand}" Content="Delete Preset" AutomationProperties.Name="Delete selected sandbox preset" />
                        </WrapPanel>

                        <TextBlock Classes="caption" Text="{Binding SearchSummary}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{Binding PresetLibrarySummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Classes="workspace-band" Padding="0">
                <Grid RowDefinitions="Auto,Auto">
                    <Grid Margin="16,12,16,0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="kicker" Text="Sandbox Categories" />
                            <TextBlock Classes="caption"
                                       Text="{Binding SearchSummary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Classes="caption"
                                   VerticalAlignment="Center"
                                   Text="{Binding SelectedCategoryStatus}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="8"
                          Margin="8,8,8,0"
                          IsVisible="{Binding HasCategories}">
                        <Button x:Name="PreviousCategoriesButton"
                                Grid.Column="0"
                                Classes="action-secondary"
                                Width="42"
                                MinHeight="64"
                                Padding="0"
                                VerticalAlignment="Top"
                                Content="←"
                                Click="OnPreviousCategoriesClick"
                                IsEnabled="False"
                                ToolTip.Tip="Show previous categories"
                                AutomationProperties.Name="Show previous sandbox categories" />

                        <ScrollViewer x:Name="CategoryScrollViewer"
                                      Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      ScrollChanged="OnCategoryScrollChanged">
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SandboxCategoryViewModel">
                                        <Button Classes="category-tab"
                                                Classes.active="{Binding IsSelected}"
                                                Click="OnOpenCategoryClick"
                                                AutomationProperties.Name="{Binding Title}"
                                                MinWidth="152"
                                                Margin="0,0,6,0">
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Title}" />
                                                <TextBlock Classes="caption" Text="{Binding StatusText}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button x:Name="NextCategoriesButton"
                                Grid.Column="2"
                                Classes="action-secondary"
                                Width="42"
                                MinHeight="64"
                                Padding="0"
                                VerticalAlignment="Top"
                                Content="→"
                                Click="OnNextCategoriesClick"
                                IsEnabled="False"
                                ToolTip.Tip="Show more categories, including mod settings"
                                AutomationProperties.Name="Show more sandbox and mod categories" />
                    </Grid>

                    <Border Grid.Row="1"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16"
                            IsVisible="{Binding HasNoSelectedCategory}">
                        <TextBlock Classes="caption" Text="No sandbox categories match the current search." TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="3"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="720">
                <StackPanel>
                    <Border x:Name="SelectedCategoryAnchor" Classes="workspace-band" Padding="16" Margin="0,0,0,12" IsVisible="{Binding HasSelectedCategory}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="kicker" Text="Category Panel" />
                                <TextBlock Classes="panel-title" FontSize="24" Text="{Binding SelectedCategoryTitle}" />
                                <TextBlock Classes="caption" Text="{Binding SelectedCategoryStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Classes="action-secondary"
                                        Command="{Binding OpenSelectedModDefinitionCommand}"
                                        Content="Open Mod Definition"
                                        IsVisible="{Binding SelectedCategory.HasSourceFile}"
                                        ToolTip.Tip="{Binding SelectedCategory.SourceFilePath}"
                                        AutomationProperties.Name="Open the selected mod sandbox option definition" />
                                <Button Classes="action-secondary"
                                        Command="{Binding ToggleCategoryExpandedCommand}"
                                        CommandParameter="{Binding SelectedCategory}"
                                        Content="{Binding SelectedCategory.ExpandButtonLabel}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding SelectedCategory.Sections}"
                                  IsVisible="{Binding HasSelectedCategory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SandboxSectionViewModel">
                                <Border Classes="workspace-band"
                                        Padding="14"
                                        Margin="0,0,0,12"
                                        IsVisible="{Binding #SandboxRoot.DataContext.SelectedCategory.IsExpanded}">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="kicker" Text="{Binding Title}" />
                                                <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap" IsVisible="{Binding HasDescription}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="action-secondary"
                                                    Command="{Binding #SandboxRoot.DataContext.ToggleSectionExpandedCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Content="{Binding ExpandButtonLabel}" />
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding IsExpanded}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SandboxFieldEditorViewModel">
                                                    <Border Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="14" Margin="0,0,0,8">
                                                        <Grid ColumnDefinitions="*,320" ColumnSpacing="18">
                                                            <StackPanel Spacing="8">
                                                                <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Label}" />
                                                                <TextBlock Classes="caption" Text="{Binding HelpText}" TextWrapping="Wrap" IsVisible="{Binding HasHelpText}" />

                                                                <WrapPanel Orientation="Horizontal" ItemHeight="28">
                                                                    <Border Classes="pill-soft-neutral" Margin="0,0,8,8" IsVisible="{Binding RequiresRestart}">
                                                                        <TextBlock Classes="pill-text-neutral" Text="Restart required" />
                                                                    </Border>
                                                                    <Border Classes="pill-soft-green" Margin="0,0,8,8" IsVisible="{Binding HasPresetValue}">
                                                                        <TextBlock Classes="pill-text-green" Text="{Binding PresetStatusText}" />
                                                                    </Border>
                                                                </WrapPanel>

                                                                <ItemsControl ItemsSource="{Binding Errors}" IsVisible="{Binding HasErrors}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Classes="caption" Foreground="{DynamicResource DangerBrush}" Text="{Binding .}" TextWrapping="Wrap" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Spacing="8">
                                                                <TextBlock Classes="caption" Text="{Binding ReadOnlyValue}" TextWrapping="Wrap" IsVisible="{Binding IsReadOnly}" />

                                                                <CheckBox Content="Enabled"
                                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                          IsEnabled="{Binding CanEdit}"
                                                                          IsVisible="{Binding IsCheckbox}" />

                                                                <ComboBox ItemsSource="{Binding Options}"
                                                                          SelectedItem="{Binding SelectedOption}"
                                                                          IsEnabled="{Binding CanEdit}"
                                                                          IsVisible="{Binding IsSelect}">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:SandboxFieldOptionViewModel">
                                                                            <TextBlock Text="{Binding Label}" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>

                                                                <TextBox Text="{Binding CurrentValue}"
                                                                         IsEnabled="{Binding CanEdit}"
                                                                         IsVisible="{Binding IsNumeric}" />

                                                                <TextBox Text="{Binding CurrentValue}"
                                                                         IsEnabled="{Binding CanEdit}"
                                                                         PasswordChar="*"
                                                                         IsVisible="{Binding IsPassword}" />

                                                                <TextBox Text="{Binding CurrentValue}"
                                                                         IsEnabled="{Binding CanEdit}"
                                                                         AcceptsReturn="True"
                                                                         Height="92"
                                                                         TextWrapping="Wrap"
                                                                         IsVisible="{Binding IsMultiline}" />

                                                                <TextBox Text="{Binding CurrentValue}"
                                                                         IsEnabled="{Binding CanEdit}"
                                                                         IsVisible="{Binding IsTextBox}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="workspace-band" Padding="18" IsVisible="{Binding HasNoSelectedCategory}">
                        <TextBlock Classes="caption" Text="Select a category to browse its sandbox settings." TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="4" Classes="danger-panel" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Classes="kicker" Text="Fresh World" />
                    <TextBlock Classes="body"
                               Text="Delete the current world so the next start generates a fresh map."
                               TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding WorldResetSummary}" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding WorldDirectory}" TextWrapping="Wrap" />

                    <WrapPanel Orientation="Horizontal" ItemHeight="32">
                        <CheckBox Content="Create backup first"
                                  IsChecked="{Binding CreateBackupBeforeWorldReset}"
                                  Margin="0,0,16,8" />
                        <CheckBox Content="Restart after reset"
                                  IsChecked="{Binding RestartAfterWorldReset}"
                                  Margin="0,0,0,8" />
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal" ItemHeight="38">
                        <Button Classes="action-danger" Command="{Binding ResetWorldCommand}" Content="Reset World" AutomationProperties.Name="Reset server world" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Classes="command-strip" Padding="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="kicker" Foreground="{DynamicResource AccentBrush}" Text="Actions" />
                        <TextBlock Classes="body" Foreground="{DynamicResource TextBrush}" Text="{Binding ActionSummary}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Foreground="{DynamicResource TextSubtleBrush}" Text="{Binding ValidationSummary}" TextWrapping="Wrap" />
                    </StackPanel>

                    <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemWidth="152" ItemHeight="38">
                        <Button Classes="action-primary" Command="{Binding SaveSettingsCommand}" Content="Apply Settings" IsEnabled="{Binding CanEdit}" />
                        <Button Classes="action-secondary" Command="{Binding SaveDraftCommand}" Content="Save Draft" IsEnabled="{Binding CanEdit}" />
                        <Button Classes="action-secondary" Command="{Binding DiscardDraftCommand}" Content="Discard Draft" />
                        <Button Classes="action-secondary" Command="{Binding ReloadCommand}" Content="Reload From Host" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
