<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PZServerLauncher.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1120"
             d:DesignHeight="900"
             x:Class="PZServerLauncher.App.Views.WorkspaceSectionView"
             x:Name="SectionRoot"
             x:DataType="vm:WorkspaceSectionViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="14" Margin="18">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
            <StackPanel Spacing="3">
                <TextBlock Classes="panel-title" FontSize="24" Text="{Binding PageTitle}" />
                <TextBlock Classes="caption" MaxLines="2" Text="{Binding PageSummary}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Classes="status-chip" VerticalAlignment="Top">
                <TextBlock Classes="chip-text" Text="{Binding DirtyStateMessage}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="14">
            <Border Classes="row-strip">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="kicker" Text="Highlights" />
                        <ItemsControl ItemsSource="{Binding Highlights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Classes="caption" Text="{Binding .}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="260" Spacing="8">
                        <TextBlock Classes="kicker" Text="Draft Note" />
                        <TextBox AcceptsReturn="True"
                                 Height="96"
                                 Text="{Binding DraftNote}"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Classes="action-primary" Command="{Binding SaveDraftCommand}" Content="Save" />
                            <Button Grid.Column="1" Classes="action-secondary" Command="{Binding DiscardDraftCommand}" Content="Discard" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
