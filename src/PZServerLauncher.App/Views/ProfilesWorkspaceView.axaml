<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PZServerLauncher.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1320"
             d:DesignHeight="980"
             x:Class="PZServerLauncher.App.Views.ProfilesWorkspaceView"
             x:Name="ProfilesRoot"
             x:DataType="vm:ProfilesWorkspaceViewModel">
    <Grid ColumnDefinitions="312,*" ColumnSpacing="14">
        <Border Classes="surface-chrome section-frame" Padding="14">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Classes="kicker" Text="Servers" />
                        <TextBlock Classes="panel-title" FontSize="22" Text="{Binding PageTitle}" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="status-chip" VerticalAlignment="Top">
                        <TextBlock Classes="chip-text" Text="{Binding ProfileCountSummary}" />
                    </Border>
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Classes="action-primary"
                            Command="{Binding Legacy.CreateStarterProfileCommand}"
                            AutomationProperties.Name="Create server profile"
                            Content="Create" />
                    <Button Grid.Column="1"
                            Classes="action-secondary"
                            Command="{Binding Legacy.DiscoverImportsCommand}"
                            AutomationProperties.Name="Scan for local servers"
                            Content="Scan" />
                </Grid>

                <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock Classes="kicker" Text="Find" />
                    <TextBox Text="{Binding ProfileSearchText, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="Name, branch, state" />
                </StackPanel>

                <ListBox Grid.Row="3"
                         ItemsSource="{Binding VisibleProfiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         Background="Transparent"
                         BorderThickness="0"
                         MinHeight="260"
                         IsVisible="{Binding HasProfiles}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProfileCardViewModel">
                            <Border Classes="data-row"
                                    Background="{Binding RosterCardBackground}"
                                    BorderBrush="{Binding RosterCardBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="0"
                                    Padding="10,9"
                                    Margin="0">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="row-title"
                                                       Foreground="{Binding RosterTitleForeground}"
                                                       Text="{Binding DisplayName}" />
                                            <TextBlock Classes="caption"
                                                       Foreground="{Binding RosterSummaryForeground}"
                                                       MaxLines="1"
                                                       Text="{Binding RosterOneLineDetail}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Classes="status-chip-accent"
                                                IsVisible="{Binding IsSelected}">
                                            <TextBlock Classes="chip-text" Text="Selected" />
                                        </Border>
                                    </Grid>

                                    <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                        <Border Background="{Binding RosterChipBackground}" CornerRadius="999" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Foreground="{Binding RosterChipForeground}" FontSize="11" FontWeight="SemiBold" Text="{Binding Branch}" />
                                        </Border>
                                        <Border Background="{Binding RosterChipBackground}" CornerRadius="999" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Foreground="{Binding RosterChipForeground}" FontSize="11" FontWeight="SemiBold" Text="{Binding RosterPrimarySignal}" />
                                        </Border>
                                        <Border Background="{Binding RosterChipBackground}" CornerRadius="999" Padding="8,3" Margin="0,0,6,0">
                                            <TextBlock Foreground="{Binding RosterChipForeground}" FontSize="11" FontWeight="SemiBold" Text="{Binding RosterSecondarySignal}" />
                                        </Border>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="3" Classes="empty-state" IsVisible="{Binding HasNoProfiles}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="panel-title" FontSize="20" Text="{Binding FirstRunHeadline}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" MaxLines="2" Text="{Binding FirstRunActionPlan}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Classes="action-primary"
                                    Command="{Binding Legacy.CreateStarterProfileCommand}"
                                    Content="Create" />
                            <Button Grid.Column="1"
                                    Classes="action-secondary"
                                    Command="{Binding Legacy.DiscoverImportsCommand}"
                                    Content="Scan" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
            <Border Classes="workspace-band" Padding="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="7">
                        <TextBlock Classes="kicker" Text="Selected Server" />
                        <TextBlock Classes="panel-title" FontSize="24" Text="{Binding WorkspaceHeadline}" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal" ItemHeight="26" IsVisible="{Binding HasSelectedProfile}">
                            <Border Classes="status-chip-accent" Margin="0,0,8,0">
                                <TextBlock Classes="chip-text" Text="{Binding SelectedProfileBranchSummary}" />
                            </Border>
                            <Border Classes="status-chip" Margin="0,0,8,0">
                                <TextBlock Classes="chip-text" Text="{Binding SelectedProfileRuntimeSummary}" />
                            </Border>
                            <Border Classes="status-chip" Margin="0,0,8,0">
                                <TextBlock Classes="chip-text" Text="{Binding SelectedProfilePortsSummary}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                MinWidth="320"
                                MaxWidth="420"
                                Spacing="6"
                                IsVisible="{Binding HasSelectedProfile}">
                        <Border Classes="diagnostic-row">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                <TextBlock Classes="kicker" Text="Next Fix" />
                                <TextBlock Grid.Row="1" Classes="caption" MaxLines="3" Text="{Binding SelectedLaunchSummary}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <TextBlock Classes="caption"
                                   FontFamily="{StaticResource MonoFont}"
                                   MaxLines="1"
                                   Text="{Binding SelectedProfilePathSummary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="empty-state" IsVisible="{Binding HasNoSelectedProfile}">
                <StackPanel Spacing="10">
                    <TextBlock Classes="panel-title" FontSize="22" Text="Choose a server" />
                    <TextBlock Classes="caption" MaxLines="2" Text="{Binding SelectedWorkspaceAction}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                        <Button Classes="action-primary"
                                Command="{Binding Legacy.CreateStarterProfileCommand}"
                                Content="Create"
                                IsVisible="{Binding HasNoProfiles}" />
                        <Button Grid.Column="1"
                                Classes="action-secondary"
                                Command="{Binding Legacy.DiscoverImportsCommand}"
                                Content="Scan"
                                IsVisible="{Binding HasImportCandidates}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="228,*" ColumnSpacing="0" IsVisible="{Binding HasSelectedProfile}">
                <Grid RowDefinitions="Auto,*" RowSpacing="0">
                    <Border Classes="empty-state" Padding="14" IsVisible="{Binding HasPendingSectionNavigation}">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                            <TextBlock Classes="panel-title" Text="Unsaved changes" />
                            <TextBlock Grid.Row="1" Classes="caption" MaxLines="2" Text="{Binding PendingSectionNavigationMessage}" TextWrapping="Wrap" />
                            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Classes="action-primary" Command="{Binding ConfirmSectionNavigationSaveCommand}" Content="Save" />
                                <Button Grid.Column="1" Classes="action-secondary" Command="{Binding ConfirmSectionNavigationDiscardCommand}" Content="Discard" />
                                <Button Grid.Column="2" Classes="action-secondary" Command="{Binding CancelSectionNavigationCommand}" Content="Cancel" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Classes="surface-chrome section-frame" Padding="10,8">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <TextBlock Classes="kicker" Text="Sections" />
                            <ScrollViewer Grid.Row="1"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SectionItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WorkspaceNavigationItemViewModel">
                                            <Button Classes="nav-item"
                                                    Margin="0,0,0,4"
                                                    Command="{Binding #ProfilesRoot.DataContext.SelectSectionCommand}"
                                                    CommandParameter="{Binding .}"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    AutomationProperties.Name="{Binding Title}"
                                                    ToolTip.Tip="{Binding Summary}">
                                                <Grid ColumnDefinitions="4,26,*" ColumnSpacing="8">
                                                    <Border Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="2"
                                                            IsVisible="{Binding IsSelected}" />
                                                    <TextBlock Grid.Column="1"
                                                               Classes="chip-text"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding IconKey}" />
                                                    <TextBlock Grid.Column="2"
                                                               Classes="nav-label"
                                                               FontSize="13"
                                                               Text="{Binding Title}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Padding="0">
                    <ContentControl Content="{Binding CurrentSection}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
