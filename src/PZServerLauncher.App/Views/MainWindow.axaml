<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PZServerLauncher.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1920"
        d:DesignHeight="1080"
        x:Class="PZServerLauncher.App.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:WorkspaceShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PZ Server Launcher"
        Width="1680"
        Height="1000"
        MinWidth="1280"
        MinHeight="820">

    <Design.DataContext>
        <vm:WorkspaceShellViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="244,*">
        <Border Classes="app-rail">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
                <StackPanel Spacing="7">
                    <TextBlock Classes="kicker" Text="Desktop Control" />
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Text="PZ Server Launcher"
                               TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal" ItemHeight="26">
                        <Border Classes="status-chip" Margin="0,0,6,6">
                            <TextBlock Classes="chip-text" Text="{Binding ProfileCountSummary}" />
                        </Border>
                        <Border Classes="status-chip" Margin="0,0,6,6">
                            <TextBlock Classes="chip-text" Text="{Binding RecentActivitySummary}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding GlobalNavigation}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WorkspaceNavigationItemViewModel">
                            <Button Classes="nav-item"
                                    Margin="0,0,0,4"
                                    Command="{Binding #RootWindow.DataContext.SelectGlobalPageCommand}"
                                    CommandParameter="{Binding .}"
                                    IsEnabled="{Binding IsEnabled}"
                                    AutomationProperties.Name="{Binding Title}"
                                    ToolTip.Tip="{Binding Summary}">
                                <Grid ColumnDefinitions="4,30,*" ColumnSpacing="9">
                                    <Border Background="{DynamicResource AccentBrush}"
                                            CornerRadius="2"
                                            IsVisible="{Binding IsSelected}" />
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource PanelSubtleBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Height="26"
                                            Width="26"
                                            VerticalAlignment="Center">
                                        <TextBlock Classes="chip-text"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding IconKey}" />
                                    </Border>
                                    <TextBlock Grid.Column="2"
                                               Classes="nav-label"
                                               Text="{Binding Title}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="3"
                        Background="{DynamicResource PanelSubtleBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0"
                        Padding="0,12,0,0">
                    <StackPanel Spacing="9">
                        <ToggleSwitch IsChecked="{Binding IsDarkMode}"
                                      Content="Dark mode"
                                      AutomationProperties.Name="Toggle dark mode" />
                        <StackPanel Spacing="2">
                            <TextBlock Classes="kicker" Text="Runtime" />
                            <TextBlock Classes="caption"
                                       MaxLines="3"
                                       Text="{Binding RuntimePostureSummary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <Button Classes="action-secondary"
                                    Command="{Binding OpenSupportCommand}"
                                    AutomationProperties.Name="Like what i do, Buy me a coffee"
                                    HorizontalContentAlignment="Stretch"
                                    ToolTip.Tip="Like what i do, Buy me a coffee">
                                <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
                                    <TextBlock FontSize="17"
                                               Text="&#x2615;"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="11"
                                               Text="Like what i do,&#x0a;Buy me a coffee"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Classes="action-danger"
                                    Command="{Binding ExitDesktopCommand}"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Close desktop app"
                                    Content="Close" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
            <Border Classes="page-header">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding CurrentPageTitle}" />
                        <TextBlock Classes="caption"
                                   MaxLines="2"
                                   Text="{Binding CurrentPageSummary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Spacing="8"
                                HorizontalAlignment="Right">
                        <TextBlock Classes="caption"
                                   HorizontalAlignment="Right"
                                   MaxLines="1"
                                   Text="{Binding ActorSummary}"
                                   TextAlignment="Right"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,12"
                    IsVisible="{Binding HasPendingNavigation}">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold"
                                   Foreground="{DynamicResource WarningBrush}"
                                   Text="Unsaved changes" />
                        <TextBlock Classes="caption"
                                   MaxLines="2"
                                   Text="{Binding PendingNavigationMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="action-primary" Command="{Binding ConfirmNavigationSaveCommand}" Content="Save" />
                    <Button Grid.Column="2" Classes="action-secondary" Command="{Binding ConfirmNavigationDiscardCommand}" Content="Discard" />
                    <Button Grid.Column="3" Classes="action-secondary" Command="{Binding CancelNavigationCommand}" Content="Cancel" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="14">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
        </Grid>
    </Grid>
</Window>
