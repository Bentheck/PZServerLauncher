<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PZServerLauncher.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1180"
             d:DesignHeight="940"
             x:Class="PZServerLauncher.App.Views.AdvancedFilesWorkspaceView"
             x:DataType="vm:AdvancedFilesWorkspaceViewModel">
    <ScrollViewer>
        <Border Classes="workspace-band" Padding="24">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="18">
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="18" Padding="22">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="kicker" Foreground="{DynamicResource AccentBrush}" Text="Advanced Files" />
                            <TextBlock FontSize="30"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"
                                       Text="{Binding ProfileDisplayName}" />
                            <TextBlock Classes="body"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding WorkspaceSummary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Background="{DynamicResource PanelSubtleBrush}"
                                CornerRadius="999"
                                Padding="14,8"
                                VerticalAlignment="Top">
                            <TextBlock Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold"
                                       Text="{Binding Branch}" />
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="14">
                    <Border Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="kicker" Text="File Mode" />
                            <TextBlock Classes="body" Text="{Binding LoadStatus}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="kicker" Text="Current File" />
                            <TextBlock Classes="body"
                                       FontFamily="Cascadia Code,Consolas,monospace"
                                       Text="{Binding CurrentPath}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="kicker" Text="Operator Guidance" />
                            <TextBlock Classes="body" Text="{Binding ActionSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Background="{DynamicResource SuccessSoftBrush}"
                            BorderBrush="{DynamicResource SuccessBrush}"
                            BorderThickness="0,1,0,1"
                            CornerRadius="0" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="kicker" Text="Structured Editor Fallback" />
                        <TextBlock Classes="body" Text="Use raw files only when a structured editor cannot safely own the file." TextWrapping="Wrap" />
                        <TextBlock Classes="body" Text="{Binding LoadStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" ColumnDefinitions="280,Auto,Auto,*" ColumnSpacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="kicker" Text="File Kind" />
                        <ComboBox ItemsSource="{Binding FileKinds}"
                                  SelectedItem="{Binding SelectedKind}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConfigFileOptionViewModel">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Classes="action-secondary"
                            VerticalAlignment="Bottom"
                            Command="{Binding LoadCommand}"
                            Content="Load File"
                            IsEnabled="{Binding CanLoad}" />

                    <Button Grid.Column="2"
                            Classes="action-primary"
                            VerticalAlignment="Bottom"
                            Command="{Binding SaveCommand}"
                            Content="Save File"
                            IsEnabled="{Binding CanSave}" />

                    <StackPanel Grid.Column="3" Spacing="4">
                        <TextBlock Classes="kicker" Text="Current Path" />
                        <TextBlock Classes="body"
                                   FontFamily="Cascadia Code,Consolas,monospace"
                                   Text="{Binding CurrentPath}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="4" ColumnDefinitions="*,320" ColumnSpacing="18">
                    <StackPanel Spacing="10">
                        <Border Background="{DynamicResource SuccessSoftBrush}"
                            BorderBrush="{DynamicResource SuccessBrush}"
                            BorderThickness="0,1,0,1"
                            CornerRadius="0"
                                Padding="12"
                                IsVisible="{Binding ShowKindMismatchWarning}">
                            <TextBlock Classes="body"
                                       Text="The selected file kind does not match the currently loaded buffer. Load the selected file before saving."
                                       TextWrapping="Wrap" />
                        </Border>

                        <TextBox MinHeight="380"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Cascadia Code,Consolas,monospace"
                                 HorizontalAlignment="Stretch"
                                 IsEnabled="{Binding IsEditorEnabled}"
                                 Text="{Binding EditorContent}"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Top" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="12">
                        <Border Classes="workspace-band" Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="kicker" Text="File Status" />
                                <TextBlock Classes="body" Text="{Binding DirtyStateMessage}" TextWrapping="Wrap" />
                                <TextBlock Classes="body"
                                           FontFamily="Cascadia Code,Consolas,monospace"
                                           Text="{Binding CurrentSha256}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="workspace-band" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="kicker" Text="Diagnostics" />
                                <ItemsControl ItemsSource="{Binding Diagnostics}" IsVisible="{Binding HasDiagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Classes="body" Text="{Binding .}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="body"
                                           IsVisible="{Binding HasNoDiagnostics}"
                                           Text="No validation diagnostics were reported for the loaded file."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </ScrollViewer>
</UserControl>
