<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PZServerLauncher.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1400"
             d:DesignHeight="940"
             x:Class="PZServerLauncher.App.Views.DashboardWorkspaceView"
             x:Name="DashboardRoot"
             x:DataType="vm:DashboardWorkspaceViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
            <Border Classes="workspace-band" Padding="14,12">
                <Grid ColumnDefinitions="1.2*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="5">
                            <TextBlock Classes="kicker" Text="Start Here" />
                            <TextBlock Classes="panel-title" FontSize="28" Text="{Binding SetupModeHeadline}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" MaxLines="2" Text="{Binding LaunchPadActionHint}" TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal" ItemHeight="38">
                            <Button Classes="action-primary"
                                    Command="{Binding Legacy.CreateStarterProfileCommand}"
                                    Content="Create"
                                    Margin="0,0,10,0" />
                            <Button Classes="action-secondary"
                                    Command="{Binding Legacy.DiscoverImportsCommand}"
                                    Content="Scan"
                                    Margin="0,0,10,0" />
                            <Button Classes="action-secondary"
                                    Command="{Binding OpenProfilesWorkspaceCommand}"
                                    Content="Servers"
                                    Margin="0,0,10,0" />
                            <Button Classes="action-secondary"
                                    Command="{Binding OpenConsolesWorkspaceCommand}"
                                    Content="Consoles" />
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" MinWidth="430" Spacing="10">
                        <TextBlock Classes="kicker" Text="Fleet Health" />
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                            <Border Classes="row-strip" Padding="8,6">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="chip-text" Text="Installed" />
                                    <TextBlock Classes="panel-title" FontSize="24" Text="{Binding InstalledProfileCount}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="row-strip" Padding="8,6">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="chip-text" Text="Running" />
                                    <TextBlock Classes="panel-title" FontSize="24" Text="{Binding RunningProfileCount}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="row-strip" Padding="8,6">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="chip-text" Text="Ready" />
                                    <TextBlock Classes="panel-title" FontSize="24" Text="{Binding LaunchReadyProfileCount}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="3" Classes="row-strip" Padding="8,6">
                                <StackPanel Spacing="3">
                                    <TextBlock Classes="chip-text" Text="Backed Up" />
                                    <TextBlock Classes="panel-title" FontSize="24" Text="{Binding BackupCoverageCount}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="1.05*,.95*" ColumnSpacing="18">
                <Border Classes="workspace-band" Padding="14,10">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Classes="kicker" Text="Imports" />
                                <TextBlock Classes="panel-title" FontSize="22" Text="{Binding ImportSummary}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="action-secondary"
                                    Command="{Binding Legacy.DiscoverImportsCommand}"
                                    Content="Scan" />
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Legacy.ImportCandidates}" IsVisible="{Binding HasImportCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ImportCandidateViewModel">
                                    <Border Classes="divider-row">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                            <StackPanel Spacing="3">
                                                <TextBlock Classes="row-title" Text="{Binding DisplayName}" />
                                                <TextBlock Classes="caption" MaxLines="1" Text="{Binding ServerName}" />
                                                <TextBlock Classes="caption"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           MaxLines="1"
                                                           Text="{Binding CacheDirectory}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="action-primary"
                                                    Command="{Binding #DashboardRoot.DataContext.Legacy.ImportCandidateCommand}"
                                                    CommandParameter="{Binding .}"
                                                    Content="{Binding ImportActionLabel}"
                                                    IsEnabled="{Binding CanImport}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="1" Classes="empty-state" IsVisible="{Binding HasNoImportCandidates}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="panel-title" FontSize="18" Text="No import candidates" />
                                <TextBlock Classes="caption" MaxLines="2" Text="Run a scan to find existing Project Zomboid server folders." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="workspace-band" Padding="14,10">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Classes="kicker" Text="Recent Activity" />
                            <TextBlock Classes="panel-title" FontSize="22" Text="{Binding RecentJobSummary}" TextWrapping="Wrap" />
                        </StackPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Legacy.RecentJobs}" IsVisible="{Binding HasRecentJobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShellItemViewModel">
                                    <Border Classes="divider-row">
                                        <StackPanel Spacing="3">
                                            <TextBlock Classes="row-title" Text="{Binding Title}" />
                                            <TextBlock Classes="caption" MaxLines="2" Text="{Binding Detail}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="1" Classes="empty-state" IsVisible="{Binding HasNoRecentJobs}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="panel-title" FontSize="18" Text="No recent activity" />
                                <TextBlock Classes="caption" MaxLines="2" Text="Server installs, updates, launches, backups, and imports will appear here." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Border Classes="inline-warning">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="kicker" Text="Next Action" />
                        <TextBlock Classes="panel-title" FontSize="20" Text="{Binding FleetNextStepSummary}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" MaxLines="2" Text="{Binding FleetRiskSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" ItemHeight="34" VerticalAlignment="Center">
                        <Button Classes="action-secondary"
                                Command="{Binding OpenHostWorkspaceCommand}"
                                Content="App"
                                Margin="0,0,8,0" />
                        <Button Classes="action-secondary"
                                Command="{Binding OpenProfilesWorkspaceCommand}"
                                Content="Servers" />
                    </WrapPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
