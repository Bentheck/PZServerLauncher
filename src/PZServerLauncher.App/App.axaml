<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PZServerLauncher.App.App"
             xmlns:local="using:PZServerLauncher.App"
             RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F8" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PanelSubtleBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#D6DEE8" />
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#B7C3D0" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="PressedBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#EEF2F6" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="#8B98A6" />
                    <SolidColorBrush x:Key="TextBrush" Color="#17212B" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#526170" />
                    <SolidColorBrush x:Key="TextSubtleBrush" Color="#6E7C8A" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#2563A8" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1E548F" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E7F0FA" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#D9E9F8" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#247A55" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E7F5EE" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#9A5B13" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF4DF" />
                    <SolidColorBrush x:Key="WarningBorderBrush" Color="#EACB99" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCEEEE" />
                    <SolidColorBrush x:Key="DangerBorderBrush" Color="#E5B7B4" />
                    <SolidColorBrush x:Key="FocusRingBrush" Color="#6BA4DB" />
                    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#101820" />
                    <SolidColorBrush x:Key="TerminalTextBrush" Color="#EAF0F6" />
                    <SolidColorBrush x:Key="TerminalMutedTextBrush" Color="#B8C4D0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E131A" />
                    <SolidColorBrush x:Key="PanelBrush" Color="#151B23" />
                    <SolidColorBrush x:Key="PanelSubtleBrush" Color="#1B222C" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#303B49" />
                    <SolidColorBrush x:Key="BorderStrongBrush" Color="#465466" />
                    <SolidColorBrush x:Key="HoverBrush" Color="#222C38" />
                    <SolidColorBrush x:Key="PressedBrush" Color="#2B3745" />
                    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#202832" />
                    <SolidColorBrush x:Key="DisabledTextBrush" Color="#718092" />
                    <SolidColorBrush x:Key="TextBrush" Color="#E8EEF5" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#B7C2CE" />
                    <SolidColorBrush x:Key="TextSubtleBrush" Color="#93A1B1" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#70A9E0" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8DBBE8" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1C3045" />
                    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#294967" />
                    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B1824" />
                    <SolidColorBrush x:Key="SuccessBrush" Color="#67C99A" />
                    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#173528" />
                    <SolidColorBrush x:Key="WarningBrush" Color="#F2B65B" />
                    <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A2C16" />
                    <SolidColorBrush x:Key="WarningBorderBrush" Color="#72562A" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF8A83" />
                    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A2022" />
                    <SolidColorBrush x:Key="DangerBorderBrush" Color="#744044" />
                    <SolidColorBrush x:Key="FocusRingBrush" Color="#9BC8F2" />
                    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#090D12" />
                    <SolidColorBrush x:Key="TerminalTextBrush" Color="#EAF0F6" />
                    <SolidColorBrush x:Key="TerminalMutedTextBrush" Color="#AAB8C6" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Cascadia Code, Consolas</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style Selector="Border.card, Border.surface-dark, Border.surface-soft, Border.callout-card, Border.command-card">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,14" />
        </Style>

        <Style Selector="Border.app-rail">
            <Setter Property="Background" Value="{DynamicResource PanelSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style Selector="Border.page-header">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="20,10" />
        </Style>

        <Style Selector="Border.section-frame">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="Border.surface-chrome">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="Border.detail-pane">
            <Setter Property="Background" Value="{DynamicResource PanelSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style Selector="Border.workspace-band, Border.surface-section">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,14" />
        </Style>

        <Style Selector="Border.row-strip, Border.surface-inline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,9" />
        </Style>

        <Style Selector="Border.command-strip, Border.surface-elevated">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
        </Style>

        <Style Selector="Border.inline-warning, Border.diagnostic-row">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,9" />
        </Style>

        <Style Selector="Border.data-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="9,8" />
        </Style>

        <Style Selector="Border.danger-panel">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.terminal-panel">
            <Setter Property="Background" Value="{DynamicResource TerminalBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.status-chip">
            <Setter Property="Background" Value="{DynamicResource PanelSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <Style Selector="Border.status-chip-accent">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="26" />
        </Style>

        <Style Selector="Border.divider-row">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,10" />
        </Style>

        <Style Selector="Border.section-divider">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="1" />
        </Style>

        <Style Selector="Border.empty-state">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style Selector="Border.metric-card">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style Selector="Border.selection-plate">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Border.pill-dark, Border.pill-soft-neutral">
            <Setter Property="Background" Value="{DynamicResource PanelSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.pill-soft-green">
            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style Selector="TextBlock.panel-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style Selector="TextBlock.kicker">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="TextBlock.nav-label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.row-title">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="TextBlock.chip-text">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSubtleBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBlock.pill-text-light, TextBlock.pill-text-neutral">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.pill-text-green">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="LineHeight" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBox, ComboBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style Selector="TextBox:focus, ComboBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="TextBox.code-preview, TextBox.console-stream">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="Background" Value="{DynamicResource TerminalBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TerminalTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="CheckBox, RadioButton, ToggleSwitch">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="{DynamicResource PressedBrush}" />
        </Style>

        <Style Selector="Button:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.chrome-free">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="Button.chrome-free:pointerover, Button.chrome-free:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.action-primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.action-secondary">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </Style>

        <Style Selector="Button.category-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.category-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="Button.category-tab.active">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,3" />
        </Style>

        <Style Selector="Button.action-danger">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        </Style>

        <Style Selector="Button.action-warm">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="Button.action-primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        </Style>

        <Style Selector="Button.action-primary:focus">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Button.nav-item:focus">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.action-danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </Style>
    </Application.Styles>
</Application>
